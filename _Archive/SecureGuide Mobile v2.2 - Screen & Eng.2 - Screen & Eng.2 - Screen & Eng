### 7. Sync Engine ⭐ **جديد**

**المدخلات:**
- قاعدة البيانات المحلية (SQLite)
- الخادم المركزي (GRC Platform)
- سياسة التزامن (Manual, Auto, Background)

**المخرجات:**
- Sync Status
- Conflict Resolution
- Sync Log

**المنطق:**
```python
class SyncEngine:
    def __init__(self, local_db, remote_api):
        self.local_db = local_db
        self.remote_api = remote_api
        self.sync_queue = SyncQueue()
    
    def sync(self, sync_mode="MANUAL"):
        # 1. جلب التغييرات المحلية
        local_changes = self.local_db.get_changes_since_last_sync()
        
        # 2. جلب التغييرات من الخادم
        remote_changes = self.remote_api.get_changes_since_last_sync()
        
        # 3. كشف التعارضات
        conflicts = self.detect_conflicts(local_changes, remote_changes)
        
        # 4. حل التعارضات
        resolved_conflicts = self.resolve_conflicts(conflicts)
        
        # 5. رفع التغييرات المحلية
        for change in local_changes:
            if change.id not in [c.id for c in resolved_conflicts]:
                self.remote_api.push_change(change)
        
        # 6. تنزيل التغييرات من الخادم
        for change in remote_changes:
            if change.id not in [c.id for c in resolved_conflicts]:
                self.local_db.apply_change(change)
        
        # 7. تحديث آخر تزامن
        self.local_db.update_last_sync_time()
        
        return {
            "local_changes_pushed": len(local_changes),
            "remote_changes_pulled": len(remote_changes),
            "conflicts_detected": len(conflicts),
            "conflicts_resolved": len(resolved_conflicts),
            "sync_status": "SUCCESS"
        }
    
    def detect_conflicts(self, local_changes, remote_changes):
        conflicts = []
        for local in local_changes:
            for remote in remote_changes:
                if local.id == remote.id:
                    if local.updated_at != remote.updated_at:
                        conflicts.append({
                            "artifact_id": local.id,
                            "local_version": local,
                            "remote_version": remote
                        })
        return conflicts
    
    def resolve_conflicts(self, conflicts):
        resolved = []
        for conflict in conflicts:
            # استراتيجية الحل: Last-Write-Wins أو Manual Merge
            resolution_strategy = self.get_resolution_strategy()
            
            if resolution_strategy == "LAST_WRITE_WINS":
                winner = max(conflict["local_version"], conflict["remote_version"], 
                           key=lambda x: x.updated_at)
                resolved.append({
                    "artifact_id": conflict["artifact_id"],
                    "winner": winner,
                    "resolution": "AUTO"
                })
            else:
                # Queue for manual review
                self.sync_queue.add_conflict(conflict)
        
        return resolved
