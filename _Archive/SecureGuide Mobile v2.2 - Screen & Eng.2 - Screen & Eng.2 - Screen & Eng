    # 1. Critical Gaps Filter
    critical_gaps = [a for a in artifacts if 
                     a.priority == "PRI-CRITICAL" and 
                     a.implementation_status == "STS-NOT-APPLIED"]
    if critical_gaps:
        smart_filters.append({
            "name": "Critical Gaps",
            "icon": "🔴",
            "filters": {
                "priority": ["PRI-CRITICAL"],
                "implementation_status": ["STS-NOT-APPLIED"]
            },
            "count": len(critical_gaps)
        })
    
    # 2. Needs Review Filter
    needs_review = [a for a in artifacts if a.requires_human_review]
    if needs_review:
        smart_filters.append({
            "name": "Needs Human Review",
            "icon": "👁️",
            "filters": {
                "requires_human_review": True
            },
            "count": len(needs_review)
        })
    
    # 3. Overdue Reviews Filter
    today = datetime.now().date()
    overdue = [a for a in artifacts if 
               a.next_review_date and 
               datetime.strptime(a.next_review_date, "%Y-%m-%d").date() < today]
    if overdue:
        smart_filters.append({
            "name": "Overdue Reviews",
            "icon": "⏰",
            "filters": {
                "next_review_date_before": today.isoformat()
            },
            "count": len(overdue)
        })
    
    # 4. User Behavior-Based Filters
    if user_behavior.frequently_used_domains:
        smart_filters.append({
            "name": "My Domains",
            "icon": "⭐",
            "filters": {
                "primary_domain": user_behavior.frequently_used_domains
            }
        })
    
    return smart_filters
