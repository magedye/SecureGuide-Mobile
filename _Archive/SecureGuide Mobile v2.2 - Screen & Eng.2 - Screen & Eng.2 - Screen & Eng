- Version History

**المنطق:**
```python
class AuditEngine:
    def __init__(self, db):
        self.db = db
    
    def log_change(self, artifact_id, change_type, old_value, new_value, user):
        audit_entry = {
            "id": generate_id(),
            "artifact_id": artifact_id,
            "change_type": change_type,  # CREATE, UPDATE, DELETE, STATUS_CHANGE
            "old_value": old_value,
            "new_value": new_value,
            "changed_by": user,
            "changed_at": datetime.now().isoformat(),
            "change_summary": self.generate_summary(change_type, old_value, new_value)
        }
        
        self.db.insert_audit_log(audit_entry)
        
        # إذا كان UPDATE، حفظ النسخة السابقة
        if change_type == "UPDATE":
            self.save_version(artifact_id, old_value, user)
        
        return audit_entry
    
    def save_version(self, artifact_id, artifact_data, user):
        version_entry = {
            "artifact_id": artifact_id,
            "version_number": self.get_next_version(artifact_id),
            "artifact_data": artifact_data,
            "created_by": user,
            "created_at": datetime.now().isoformat()
        }
        
        self.db.insert_artifact_version(version_entry)
    
    def get_version_history(self, artifact_id):
        return self.db.get_artifact_versions(artifact_id)
    
    def generate_summary(self, change_type, old_value, new_value):
        if change_type == "CREATE":
            return f"Created artifact {new_value['id']}"
        elif change_type == "UPDATE":
            changed_fields = self.compare_dicts(old_value, new_value)
            return f"Updated fields: {', '.join(changed_fields)}"
        elif change_type == "DELETE":
            return f"Deleted artifact {old_value['id']}"
        elif change_type == "STATUS_CHANGE":
            return f"Status changed from {old_value} to {new_value}"
