```python
def calculate_progress(artifacts, target_level):
    total = len(artifacts)
    if total == 0:
        return {"error": "No artifacts found"}
    
    # 1. حساب التطبيق (Implementation)
    applied_full = count_status(artifacts, ["STS-FULL"])
    applied_partial = count_status(artifacts, ["STS-PARTIAL"])
    applied_planned = count_status(artifacts, ["STS-PLANNED"])
    
    implementation_score = (
        (applied_full * 1.0) +
        (applied_partial * 0.5) +
        (applied_planned * 0.25)
    ) / total * 100
    
    # 2. حساب التحقق (Verification)
    verified = count_status(artifacts, ["VER-PASS"])
    verification_score = (verified / total) * 100
    
    # 3. حساب الفعالية (Effectiveness)
    effective_high = count_status(artifacts, ["EFF-HIGH"])
    effective_med = count_status(artifacts, ["EFF-MED"])
    effectiveness_score = (
        (effective_high * 1.0) +
        (effective_med * 0.5)
    ) / total * 100
    
    # 4. حساب النضج لكل مجال (Domain Maturity)
    maturity_by_domain = {}
    for domain in ["SD-01", "SD-02", "SD-03", "SD-04", "SD-05", "SD-06", "SD-07", "SD-08"]:
        domain_artifacts = filter_by_domain(artifacts, domain)
        if domain_artifacts:
            domain_impl = calculate_implementation_score(domain_artifacts)
            domain_ver = calculate_verification_score(domain_artifacts)
            domain_eff = calculate_effectiveness_score(domain_artifacts)
            
            # Weighted average: 50% Implementation, 30% Verification, 20% Effectiveness
            domain_maturity = (
                domain_impl * 0.5 +
                domain_ver * 0.3 +
                domain_eff * 0.2
            )
            
            maturity_by_domain[domain] = {
                "score": round(domain_maturity, 2),
                "level": get_maturity_level(domain_maturity),
                "implementation": round(domain_impl, 2),
                "verification": round(domain_ver, 2),
                "effectiveness": round(domain_eff, 2),
                "total_artifacts": len(domain_artifacts)
            }
    
    # 5. حساب النضج الإجمالي
    overall_score = (
        implementation_score * 0.5 +
        verification_score * 0.3 +
        effectiveness_score * 0.2
    )
    
    overall_level = get_maturity_level(overall_score)
    
    # 6. تحديد الفجوات
    gaps = identify_gaps(artifacts, target_level)
    
    # 7. حساب التقدم نحو الهدف
    target_score = MATURITY_LEVELS[target_level]["range"][0]
    progress_to_target = min(100, (overall_score / target_score) * 100)
    
    return {
        "overall_maturity": {
            "score": round(overall_score, 2),
            "level": overall_level,
            "level_number": MATURITY_LEVELS[overall_level]["level"]
        },
        "implementation": {
            "score": round(implementation_score, 2),
            "full": applied_full,
            "partial": applied_partial,
            "planned": applied_planned,
            "not_applied": total - applied_full - applied_partial - applied_planned
        },
        "verification": {
            "score": round(verification_score, 2),
            "verified": verified,
            "not_verified": total - verified
        },
        "effectiveness": {
            "score": round(effectiveness_score, 2),
            "high": effective_high,
            "medium": effective_med,
            "low": count_status(artifacts, ["EFF-LOW"]),
            "unknown": count_status(artifacts, ["EFF-UNKNOWN"])
        },
        "maturity_by_domain": maturity_by_domain,
        "gaps": gaps,
        "progress_to_target": {
            "current_score": round(overall_score, 2),
            "target_score": target_score,
            "target_level": target_level,
            "progress_percentage": round(progress_to_target, 2)
        }
    }

def get_maturity_level(score):
    for level, data in MATURITY_LEVELS.items():
        if data["range"][0] <= score <= data["range"][1]:
            return level
    return "INITIAL"
```

