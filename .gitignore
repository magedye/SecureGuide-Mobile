# ── Databases (operational/test — regenerable via ingest_raw.py; never commit) ──
*.db
*.sqlite
*.sqlite3

# The checksum-pinned production source and offline mobile release seed are
# governed release inputs/assets, not operational databases.
!catalog.db
!mobile/assets/catalog.db

# ── Build outputs (regenerable via scripts/build_release_db.py) ──
dist/
outputs/

# ── Working scratch and archived legacy duplicates (regenerable / superseded) ──
scratch/
old/

# ── Python bytecode / caches ──
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──
.venv/
venv/
env/
ENV/

# ── IDE / OS ──
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ── Temp / backup / logs ──
*.tmp
*.bak
*.log
*.orig
*~

# ── Local release signing config (secrets must never be committed) ──
local-release-signing.env
*.keystore
*.jks

# ── Regenerable promotion plan outputs (a stable sample is kept at docs/sample_promotion_plan.json) ──
consolidation/promotion/

# NOTE: intentionally NOT ignored (part of the approved source baseline):
#   migrations/**  scripts/**  docs/**  reference/*.json  reference/*.md
#   tests/fixtures/**  consolidation/**  *_REPORT.md  *_MANIFEST.md
#   SecureGuide_Mobile_Docs/**  AGENTS.md  PROJECT_*.md

# curated-import intermediates (regeneratable; classifications.json is the merged output)
consolidation/curated/batches/
consolidation/curated/results/
consolidation/unified/blocks/
consolidation/unified/results/
